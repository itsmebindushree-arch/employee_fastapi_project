# Copy this file to .env and replace the placeholders. Do not commit .env.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=employee_management
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password

# Alternatively, set a complete SQLAlchemy URL (takes precedence over values above).
# DATABASE_URL=mysql+pymysql://your_mysql_username:your_mysql_password@localhost:3306/employee_management?charset=utf8mb4
